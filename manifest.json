{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Themes for Teams",
  "version": "0.5.0",
  "description": "Custom Styles for Microsoft Teams to boost productivity.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://teams.microsoft.com/v2/*", "*://teams.cloud.microsoft/*"],
      "css": ["styles.css"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://teams.microsoft.com/v2/*", "*://teams.cloud.microsoft/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "no-animations.css", "themes/*.css"],
      "matches": ["*://teams.microsoft.com/*", "*://teams.cloud.microsoft/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "themes-for-teams@goshow.me",
      "strict_min_version": "128.0"
    }
  }
}